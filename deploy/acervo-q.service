[Unit]
Description=Acervo extracao e OCR
After=acervo.service
[Service]
User=acervo
Group=www-data
WorkingDirectory=/opt/acervo
EnvironmentFile=/etc/acervo.env
ExecStart=/opt/acervo/.venv/bin/python manage.py qcluster
Restart=on-failure
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/acervo
[Install]
WantedBy=multi-user.target
